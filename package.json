{
  "name": "scayvo",
  "version": "0.1.0",
  "description": "Your next demo. One key away. Local scene controller for a running React + Vite SPA. Loopback-only Director on the same Vite server. Pack a local tarball — not on public npm.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scayar/SCAYVO.git"
  },
  "bugs": {
    "url": "https://github.com/Scayar/SCAYVO/issues"
  },
  "homepage": "https://github.com/Scayar/SCAYVO#readme",
  "keywords": [
    "vite",
    "react",
    "typescript",
    "spa",
    "demo",
    "msw",
    "mock-service-worker",
    "vite-plugin",
    "developer-experience",
    "scene-controller",
    "cli",
    "local-first",
    "loopback",
    "hotkeys"
  ],
  "bin": {
    "scayvo": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.nl.md",
    "README.ar.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup && vite build --config vite.director.config.ts",
    "build:lib": "tsup",
    "build:director": "vite build --config vite.director.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.director.json && tsc --noEmit -p examples/demo/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "demo": "npm run start --prefix examples/demo",
    "prepack": "npm run build",
    "pack:local": "npm pack"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "vite": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "2.6.1",
    "msw": "2.11.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.2.8",
    "@playwright/test": "1.55.1",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
